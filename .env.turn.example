# DNS-only A record pointing at the same public IPv4 as Traefik.
TURN_DOMAIN=turn.example.com
TURN_PUBLIC_IP=203.0.113.10
# Address actually assigned to the server; use its private address behind 1:1 NAT.
TURN_RELAY_IP=203.0.113.10
TURN_LISTEN_IP=0.0.0.0
TURN_PORT=3478
TURN_TLS_PORT=5349
TURN_MIN_PORT=49160
TURN_MAX_PORT=49999

# Readable by the dedicated UID/GID 24001. fullchain.pem + privkey.pem must match TURN_DOMAIN.
TURN_TLS_DIR=./deploy/turn/tls
TURN_AUTH_SECRET_FILE=./deploy/turn/private/auth-secret

# Allocation limits, then bytes/sec (per session and aggregate, each direction).
TURN_USER_QUOTA=16
TURN_TOTAL_QUOTA=200
TURN_MAX_BPS=1250000
TURN_BPS_CAPACITY=50000000
# Loopback-only exporter. No username labels.
TURN_METRICS_PORT=9641
