TRAEFIK_NETWORK=traefik
DOCKER_SOCKET_PATH=/var/run/docker.sock
# File must be readable by UID 65532; generate bcrypt hashes with htpasswd -nB.
TRAEFIK_USERS_FILE=./deploy/traefik/private/users
# Optional shared-IP 443 TURN/TLS passthrough. Leave blank until Coturn TLS is ready.
TURN_DOMAIN=
TURN_BACKEND=host.docker.internal:5349
