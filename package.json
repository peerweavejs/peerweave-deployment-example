{
  "name": "peerweave-deployment-example",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node tools/dev.mjs",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p tsconfig.tools.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check:repo": "node tools/check-repository.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:browser": "vitest run --config vitest.e2e.config.ts",
    "test:e2e": "pnpm test:browser && node tools/test-app.mjs",
    "test:deployment": "node tools/test-deployment.mjs",
    "test:turn:deployment": "node tools/test-turn-deployment.mjs",
    "check": "pnpm lint && pnpm check:repo && pnpm build && pnpm typecheck && pnpm test:coverage && pnpm test:e2e",
    "build:images": "./tools/build-images.sh",
    "vendor:peerweave": "node tools/vendor-peerweave.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.15",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.4",
    "playwright": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  },
  "description": "A self-hosted Peerweave reference app with authenticated signaling, room authorization, short-lived TURN credentials, and Traefik/Coturn Docker Compose deployment.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peerweavejs/peerweave-deployment-example.git"
  },
  "homepage": "https://github.com/peerweavejs/peerweave-deployment-example#readme",
  "bugs": {
    "url": "https://github.com/peerweavejs/peerweave-deployment-example/issues"
  },
  "keywords": [
    "peerweave",
    "webrtc",
    "typescript",
    "docker-compose",
    "traefik",
    "coturn",
    "self-hosted"
  ]
}
