# Bare public hostname, without scheme, port or path.
PEERWEAVE_DOMAIN=peerweave.example.com

# Match the prefix/tag passed to tools/build-images.sh.
PEERWEAVE_IMAGE_PREFIX=peerweave-example
PEERWEAVE_IMAGE_TAG=local

# Existing Traefik Docker network and HTTPS entrypoint.
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure

# Existing certificate resolver; leave blank when the entrypoint/default store handles TLS.
TRAEFIK_CERT_RESOLVER=

# Optional existing middleware chain, applied to BOTH the website and signaling routers.
# Example: private-access@file
TRAEFIK_MIDDLEWARES=

# File mounts readable only by the backend's UID 1000. See the deployment guide.
ROOM_POLICY_FILE=./deploy/app/private/rooms.json
TURN_AUTH_SECRET_FILE=./deploy/app/private/turn-auth-secret
TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349?transport=tcp
PEERWEAVE_ICE_POLICY=all
